{
  "name": "shivanarrthine.github.io",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build-css": "sass public/sass/application.sass public/css/styles.css --load-path=public/sass --source-map",
    "post-css": "npx postcss public/css/styles.css --config postcss.config.js -o public/css/styles.min.css",
    "watch-css": "nodemon -e sass -x \"npm run build-css && npm run post-css\""
  },
