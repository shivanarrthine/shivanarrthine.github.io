  },
  "homepage": "https://github.com/shivanarrthine/shivanarrthine.github.io#readme",
  "overrides": {
    "braces": "3.0.3"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "cssnano": "^7.1.9",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.31",
    "postcss-cli": "^12.0.0",
    "sass": "^1.106.1"
  }
}
